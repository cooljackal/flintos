---
// Enable client-side routing (Astro's ClientRouter). Two wins:
//  - navigation swaps content in place, so the already-loaded fonts and CSS
//    are reused -- no fallback -> Plex font re-flash on every page change;
//  - it gives view transitions (a subtle cross-fade) between pages for free.
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
---

<Default><slot /></Default>
<ClientRouter />

{/*
  PostHog analytics. `is:inline` keeps Astro from bundling the IIFE — it must run
  as-is in the browser. The `__SV` guard makes re-init idempotent if the head
  script re-runs on a ClientRouter transition, and `defaults` captures
  history-based pageviews, so SPA navigations are tracked too. The `phc_...` key
  is a public client-side project key, safe to ship in the page.
*/}
