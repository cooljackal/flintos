    posthog.init('phc_wxC5o3yWgh8jAD98RGZ8i7ERdJPhZdF43GooTihU28ea', {
        api_host: 'https://r.flintos.dev', // managed reverse proxy domain
        ui_host: 'https://us.posthog.com', // so PostHog links point back to the app
        defaults: '2026-05-30',
        person_profiles: 'identified_only', // or 'always' to profile anonymous users too
